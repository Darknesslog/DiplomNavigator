# Приложение
APP_PORT=8000
DEBUG=true
# Set a random secret of at least 32 bytes; never commit the real value.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
LOGIN_COOLDOWN_MINUTES=15
ENVIRONMENT=development

# PostgreSQL
POSTGRES_USER=diplom_user
POSTGRES_PASSWORD=diplom_password
POSTGRES_DB=diplom_navigator
POSTGRES_PORT=5432

# Подключение к БД
DATABASE_URL=postgresql+psycopg://diplom_user:diplom_password@localhost:5432/diplom_navigator
